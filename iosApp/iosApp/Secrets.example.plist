<?xml version="1.0" encoding="UTF-8"?>
<!--
  Supabase 시크릿 템플릿. 복사해서 Secrets.plist로 만들고 실제 값을 채우세요.
    cp Secrets.example.plist Secrets.plist
  Secrets.plist는 .gitignore 처리되어 커밋되지 않습니다.
  값이 비어 있으면 앱은 Stub sync로 폴백합니다(크래시 없음).
  AMPLITUDE_API_KEY는 릴리스 빌드에서만 쓰입니다(Android local.properties의 같은 키).
  비어 있거나 디버그 빌드면 이벤트를 콘솔에만 출력합니다.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>SUPABASE_URL</key>
    <string>https://YOUR-PROJECT.supabase.co</string>
    <key>SUPABASE_ANON_KEY</key>
    <string>YOUR_SUPABASE_ANON_KEY</string>
    <key>AMPLITUDE_API_KEY</key>
    <string>YOUR_AMPLITUDE_API_KEY</string>
</dict>
</plist>
